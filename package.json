{
  "name": "kryndel",
  "version": "0.4.3",
  "description": "Observability & alerts layer for XRPL programmable logic — index, decode, trace and alert on deployed contracts (EVM Sidechain + native).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project packages/core/tsconfig.json && tsc --project packages/cli/tsconfig.json && tsc --project packages/worker/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint packages/"
  },
  "keywords": [
    "xrpl",
    "observability",
    "smart-contracts",
    "xrpl-evm-sidechain",
    "indexer",
    "decoder",
    "alerts",
    "monitoring"
  ],
  "author": "Roger Pérez <rperezga@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "ripple-address-codec": "^5.0.1",
    "ripple-binary-codec": "^2.10.0",
    "xrpl": "^5.1.0",
    "viem": "^2.56.0",
    "mongodb": "^6.9.0",
    "ws": "^8.21.3"
  }
}
