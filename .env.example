# Kryndel — variables de entorno (NO commitear el .env real con secretos).
# Cárgalas con: node --env-file=.env ...   (Node ≥ 20)

# WebSocket de AlphaNet (rippled/Clio) — watcher nativo (Etapa 2). Endpoint público de AlphaNet:
ALPHANET_WS=wss://alphanet.nerdnest.xyz
# RPC de AlphaNet (para event_history / consultas):
ALPHANET_RPC=https://alphanet.rpc.nerdnest.xyz

# RPC del XRPL EVM Sidechain (mainnet, chain ID 1440000) — watcher EVM (Etapa 3).
EVM_RPC_URL=https://rpc.xrplevm.org
# Contrato de demo: WXRP (Wrapped XRP) en el EVM Sidechain mainnet.
EVM_DEMO_CONTRACT=0x7C21a90E3eCD3215d16c3BBe76a491f8f792d4Bf

# MongoDB — indexer (Etapa 4).
MONGODB_URI=mongodb://localhost:27017

# Bot de Telegram — alertas (Etapa 6). SECRETO: rellénalo solo en .env, nunca en .env.example.
TELEGRAM_BOT_TOKEN=
# Chat ID destino de las alertas — obtenlo con: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
