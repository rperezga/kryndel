# Kryndel — environment variables (DO NOT commit the real .env with secrets).
# Load with: node --env-file=.env ...   (Node ≥ 20)

# XRPL EVM Sidechain (mainnet, chain ID 1440002) — EVM watcher + trace.
EVM_RPC_URL=https://rpc.xrplevm.org
# Demo contract: WXRP (Wrapped XRP) on EVM Sidechain mainnet.
EVM_DEMO_CONTRACT=0x7C21a90E3eCD3215d16c3BBe76a491f8f792d4Bf

# XRPL AlphaNet — XLS-0101 native WASM contracts (watcher + trace --net alphanet).
# Note: AlphaNet endpoint availability is intermittent as of June 2026.
# Check LIMITATIONS.md for current status before using.
ALPHANET_WS=wss://alphanet.nerdnest.xyz
ALPHANET_RPC=https://alphanet.rpc.nerdnest.xyz

# MongoDB — indexer.
MONGODB_URI=mongodb://localhost:27017

# Telegram bot — alerts. SECRET: fill only in .env, never in .env.example.
TELEGRAM_BOT_TOKEN=
# Destination chat ID — get it with: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
